# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=assetflow
POSTGRES_USER=assetflow
POSTGRES_PASSWORD=changeme

# Full connection string used by the backend (must match the values above)
DATABASE_URL=postgresql://assetflow:changeme@localhost:5432/assetflow

# ── External APIs ─────────────────────────────────────────────────────────────
# FMP (Financial Modeling Prep) — free tier at financialmodelingprep.com
# Required for Phase 6 (screener + news). Leave empty to skip.
FMP_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Vite reads this from frontend/.env.local (see frontend/.env.local.example)
# VITE_API_URL=http://localhost:8000

# ── Local AI (Phase 9) ────────────────────────────────────────────────────────
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
